# Скопируйте в .env и заполните. Файл .env не коммитится.

# Ключ подписи JWT. Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Какой ИИ использовать: anthropic (Claude, основной вариант) или openai
# (OpenAI или любой сервис с OpenAI-совместимым API — см. README, раздел «Другие провайдеры»)
LLM_PROVIDER=anthropic

# Для LLM_PROVIDER=openai:
OPENAI_API_KEY=
# Пусто — официальный OpenAI; для совместимых сервисов — их адрес API
OPENAI_BASE_URL=
# Название модели из кабинета провайдера (обязательно)
OPENAI_MODEL=
# Максимум токенов ответа (0 — не передавать)
OPENAI_MAX_TOKENS=0

# Ключ Anthropic API (https://console.anthropic.com). Можно не указывать, если
# задана переменная окружения ANTHROPIC_API_KEY или выполнен `ant auth login`.
ANTHROPIC_API_KEY=

# Модель и глубина рассуждений (low | medium | high | xhigh | max)
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=high
LLM_MAX_TOKENS=64000
# Серверный фолбэк при отказе модели (только прямой Claude API)
LLM_FALLBACKS=true

# --- Публичный сервер ---
# Каждая обработка — платный вызов LLM с вашего ключа. На сервере в интернете закройте регистрацию
# и создавайте пользователей командой: python scripts/create_user.py user@example.com
REGISTRATION_ENABLED=true
# Или разрешите регистрацию только этим адресам (через запятую)
ALLOWED_EMAILS=
# Или регистрация по коду приглашения (REGISTRATION_ENABLED=true): без кода зарегистрироваться нельзя.
# Код — от 8 символов, сообщайте его только своим сотрудникам.
REGISTRATION_INVITE_CODE=
# Лимиты обработок за последние 24 часа (0 — без лимита)
MAX_LLM_REQUESTS_PER_USER_PER_DAY=30
MAX_LLM_REQUESTS_PER_DAY=100
# Блокировка входа после N неудачных попыток на email
LOGIN_MAX_FAILURES=10
LOGIN_LOCKOUT_MINUTES=15
# Swagger UI на /docs
ENABLE_API_DOCS=true

# Язык сайта по умолчанию, пока пользователь не выбрал другой: ru | en | ka
DEFAULT_LANGUAGE=ru

# Срок жизни сессии, минут
ACCESS_TOKEN_EXPIRE_MINUTES=480
# true — если приложение работает за HTTPS
COOKIE_SECURE=false

# Хранилище (по умолчанию — папка data/ в корне проекта)
# DATABASE_URL=sqlite:///./data/app.db
# UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=25

# Длина кода ТН ВЭД для проверки формата
HS_CODE_LENGTH=10
